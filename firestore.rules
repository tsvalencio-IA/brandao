rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bootstrapAdmin() { return signedIn() && request.auth.uid == 'e2hp11Q3wqSiVD1I1YiUGpYgGsi2'; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    function activeUser() {
      return signedIn() && (
        bootstrapAdmin() ||
        (hasProfile() &&
         profile().active == true &&
         profile().deleted != true &&
         profile().status_usuario == 'ATIVO')
      );
    }

    function isRole(role) { return bootstrapAdmin() || (activeUser() && profile().role == role); }
    function roleIn(roles) { return bootstrapAdmin() || (activeUser() && profile().role in roles); }

    function hasPermission(permission) {
      return bootstrapAdmin() || (
        activeUser() &&
        profile().permissoes_especiais is list &&
        permission in profile().permissoes_especiais
      );
    }

    function canManageUsers() { return isRole('gestor') || hasPermission('gerenciar_usuarios'); }
    function canRegisterDown() { return roleIn(['gestor','adm','adm_opm','mecanico']) || hasPermission('registrar_baixa'); }
    function canDiagnose() { return roleIn(['gestor','mecanico']) || hasPermission('diagnostico'); }
    function canChecklist() { return roleIn(['gestor','mecanico']) || hasPermission('checklist'); }
    function canOES() { return roleIn(['gestor','mecanico']) || hasPermission('gerar_oes'); }
    function canApproveBudget() { return roleIn(['gestor','adm']) || hasPermission('aprovar_orcamento'); }
    function canUGE() { return roleIn(['gestor','adm','uge']) || hasPermission('acessar_uge'); }

    function validPendingSelfRegistration(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == null &&
        request.resource.data.active == false &&
        request.resource.data.status_usuario == 'PENDENTE' &&
        request.resource.data.approval_status == 'PENDENTE' &&
        request.resource.data.deleted != true &&
        request.resource.data.permissoes_especiais is list &&
        request.resource.data.permissoes_especiais.size() == 0 &&
        request.resource.data.email == request.auth.token.email;
    }

    function safeSelfPresenceUpdate(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        resource.data.deleted != true &&
        resource.data.status_usuario != 'EXCLUIDO' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'online',
          'last_seen',
          'last_login_at',
          'last_logout_at',
          'presence_session_id'
        ]);
    }

    match /users/{uid} {
      allow read: if canManageUsers() || (signedIn() && request.auth.uid == uid);
      allow create: if canManageUsers() || validPendingSelfRegistration(uid);
      allow update: if canManageUsers() || safeSelfPresenceUpdate(uid);
      allow delete: if isRole('gestor');
    }

    match /user_presence/{uid} {
      allow read, write: if false;
    }

    match /public_vehicle_tokens/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if roleIn(['gestor','adm','mecanico']);
    }

    match /operational_logs/{id} {
      allow create: if activeUser() || (
        request.resource.data.public_token is string &&
        exists(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)) &&
        get(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)).data.active == true &&
        request.resource.data.vehicle_id ==
          get(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)).data.vehicle_id
      );
      allow read: if activeUser() && (
        roleIn(['gestor','adm','mecanico']) ||
        (profile().role == 'adm_opm' && resource.data.vehicle_unit == profile().unit)
      );
      allow update: if roleIn(['gestor','adm','mecanico']) || hasPermission('corrigir_operacional');
      allow delete: if isRole('gestor');
    }

    match /vehicles/{id} {
      allow read: if activeUser() && (
        roleIn(['gestor','adm','mecanico']) ||
        (profile().role == 'adm_opm' && resource.data.unit == profile().unit)
      );
      allow create: if roleIn(['gestor','adm','mecanico']);
      allow update: if roleIn(['gestor','adm','mecanico']) ||
        (profile().role == 'adm_opm' && resource.data.unit == profile().unit);
      allow delete: if isRole('gestor');
    }

    match /vehicle_downs/{id} {
      allow read: if activeUser() && (
        roleIn(['gestor','adm','mecanico']) ||
        (profile().role == 'adm_opm' && resource.data.unit == profile().unit)
      );
      allow create: if canRegisterDown();
      allow update: if canRegisterDown() || canDiagnose();
      allow delete: if isRole('gestor');
    }

    match /diagnoses/{id} {
      allow read: if activeUser() && roleIn(['gestor','adm','mecanico']);
      allow create, update: if canDiagnose();
      allow delete: if isRole('gestor');
    }

    match /checklists/{id} {
      allow read: if activeUser() && roleIn(['gestor','adm','mecanico']);
      allow create, update: if canChecklist();
      allow delete: if isRole('gestor');
    }

    match /maintenance_orders/{id} {
      allow read: if activeUser() && (
        roleIn(['gestor','adm','mecanico','uge']) ||
        (profile().role == 'adm_opm' && resource.data.unit == profile().unit) ||
        (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id)
      );
      allow create: if canOES();
      allow update: if canOES() || canApproveBudget() || canUGE() ||
        (activeUser() && profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id);
      allow delete: if isRole('gestor');
    }

    match /budgets/{id} {
      allow read: if activeUser() && (
        roleIn(['gestor','adm','mecanico','uge']) ||
        (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id)
      );
      allow create: if activeUser() && (roleIn(['gestor','mecanico']) || profile().role == 'oficina');
      allow update: if canApproveBudget() ||
        (activeUser() && profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id);
      allow delete: if isRole('gestor');
    }

    match /workshops/{id} {
      allow read: if activeUser();
      allow create, update: if roleIn(['gestor','adm']) || hasPermission('gerenciar_oficinas');
      allow delete: if isRole('gestor');
    }

    match /parts/{id} {
      allow read, create, update: if roleIn(['gestor','mecanico']) || hasPermission('gerenciar_estoque');
      allow delete: if isRole('gestor');
    }

    match /stock_movements/{id} {
      allow read, create: if roleIn(['gestor','mecanico']) || hasPermission('gerenciar_estoque');
      allow update, delete: if isRole('gestor');
    }

    match /quick_maintenances/{id} {
      allow read, create, update: if roleIn(['gestor','mecanico']) || hasPermission('manutencao_rapida');
      allow delete: if isRole('gestor');
    }

    match /financial_flows/{id} {
      allow read: if canUGE() ||
        (activeUser() && profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id);
      allow create: if canApproveBudget();
      allow update: if canUGE();
      allow delete: if isRole('gestor');
    }

    match /commitments/{id} {
      allow read, create, update: if canUGE();
      allow delete: if isRole('gestor');
    }

    match /invoices/{id} {
      allow read: if canUGE() ||
        (activeUser() && profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id);
      allow create: if canUGE() || (activeUser() && profile().role == 'oficina');
      allow update: if canUGE();
      allow delete: if isRole('gestor');
    }

    match /payments/{id} {
      allow read: if canUGE();
      allow create, update: if canUGE() || hasPermission('aprovar_pagamento');
      allow delete: if isRole('gestor');
    }

    match /attachments/{id} {
      allow read, create: if activeUser();
      allow update, delete: if isRole('gestor');
    }

    match /oes_counters/{id} {
      allow read: if activeUser();
      allow create, update: if canOES();
      allow delete: if isRole('gestor');
    }

    match /organizational_units/{id} {
      allow read: if activeUser();
      allow write: if isRole('gestor');
    }

    match /audit_logs/{id} {
      allow create: if signedIn() &&
        request.resource.data.user_id == request.auth.uid;
      allow read: if isRole('gestor') || hasPermission('acessar_auditoria');
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
