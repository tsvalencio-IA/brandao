rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bootstrapAdmin() { return signedIn() && request.auth.uid == 'uwUU8OkzRbfBtlVR1oeT72H0jYE2'; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    function activeUser() {
      return signedIn() && (
        bootstrapAdmin() ||
        (hasProfile() &&
         profile().active == true &&
         profile().deleted != true &&
         profile().status_usuario == 'ATIVO')
      );
    }

    function isRole(role) { return bootstrapAdmin() || (activeUser() && profile().role == role); }
    function roleIn(roles) { return bootstrapAdmin() || (activeUser() && profile().role in roles); }

    function hasPermission(permission) {
      return bootstrapAdmin() || (
        activeUser() &&
        profile().permissoes_especiais is list &&
        permission in profile().permissoes_especiais
      );
    }

    function legacyFullAccess() {
      return activeUser() &&
        hasPermission('gerenciar_usuarios') &&
        hasPermission('registrar_baixa') &&
        hasPermission('diagnostico') &&
        hasPermission('checklist') &&
        hasPermission('gerar_oes') &&
        hasPermission('aprovar_orcamento') &&
        hasPermission('gerenciar_oficinas') &&
        hasPermission('gerenciar_estoque') &&
        hasPermission('manutencao_rapida') &&
        hasPermission('acessar_uge') &&
        hasPermission('corrigir_operacional') &&
        hasPermission('acessar_auditoria') &&
        hasPermission('inativar_viatura') &&
        hasPermission('aprovar_pagamento');
    }

    function fullAccess() {
      return bootstrapAdmin() || isRole('gestor') || hasPermission('acesso_total') || legacyFullAccess();
    }

    function canManageUsers() { return fullAccess() || hasPermission('gerenciar_usuarios'); }
    function canRegisterDown() { return fullAccess() || roleIn(['gestor','adm','adm_opm','mecanico']) || hasPermission('registrar_baixa'); }
    function canDiagnose() { return fullAccess() || roleIn(['gestor','mecanico']) || hasPermission('diagnostico'); }
    function canChecklist() { return fullAccess() || roleIn(['gestor','mecanico']) || hasPermission('checklist'); }
    function canOES() { return fullAccess() || roleIn(['gestor','mecanico']) || hasPermission('gerar_oes'); }
    function canApproveBudget() { return fullAccess() || roleIn(['gestor','adm']) || hasPermission('aprovar_orcamento'); }
    function canManageWorkshops() { return fullAccess() || roleIn(['gestor','adm']) || hasPermission('gerenciar_oficinas'); }
    function canUGE() { return fullAccess() || roleIn(['gestor','adm','uge']) || hasPermission('acessar_uge'); }
    function canStock() { return fullAccess() || roleIn(['gestor','mecanico']) || hasPermission('gerenciar_estoque'); }
    function canQuickMaintenance() { return fullAccess() || roleIn(['gestor','mecanico']) || hasPermission('manutencao_rapida'); }
    function canOperationalControl() { return fullAccess() || roleIn(['gestor','adm','adm_opm','mecanico']) || hasPermission('corrigir_operacional'); }
    function canSeeAudit() { return fullAccess() || hasPermission('acessar_auditoria'); }

    function needsVehicleRead() {
      return fullAccess() ||
        roleIn(['gestor','adm','mecanico']) ||
        hasPermission('registrar_baixa') ||
        hasPermission('diagnostico') ||
        hasPermission('checklist') ||
        hasPermission('gerar_oes') ||
        hasPermission('manutencao_rapida') ||
        hasPermission('corrigir_operacional') ||
        hasPermission('inativar_viatura');
    }

    function unitMatchesResource() {
      return profile().role != 'adm_opm' || profile().unit == null || profile().unit == '' || resource.data.unit == profile().unit;
    }

    function unitMatchesRequest() {
      return profile().role != 'adm_opm' || profile().unit == null || profile().unit == '' || request.resource.data.unit == profile().unit;
    }

    function validPendingSelfRegistration(uid) {
      return signedIn() && request.auth.uid == uid &&
        request.resource.data.role == null &&
        request.resource.data.active == false &&
        request.resource.data.status_usuario == 'PENDENTE' &&
        request.resource.data.approval_status == 'PENDENTE' &&
        request.resource.data.deleted != true &&
        request.resource.data.permissoes_especiais is list &&
        request.resource.data.permissoes_especiais.size() == 0 &&
        request.resource.data.email == request.auth.token.email;
    }

    function safeSelfPresenceUpdate(uid) {
      return signedIn() && request.auth.uid == uid &&
        resource.data.deleted != true && resource.data.status_usuario != 'EXCLUIDO' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'online','last_seen','last_login_at','last_logout_at','presence_session_id'
        ]);
    }

    match /users/{uid} {
      allow read: if canManageUsers() || (signedIn() && request.auth.uid == uid);
      allow create: if canManageUsers() || validPendingSelfRegistration(uid);
      allow update: if canManageUsers() || safeSelfPresenceUpdate(uid);
      allow delete: if fullAccess();
    }

    match /user_presence/{uid} { allow read, write: if false; }

    match /public_vehicle_tokens/{token} {
      allow get: if true;
      allow list: if fullAccess();
      allow create, update, delete: if fullAccess() || roleIn(['gestor','adm','mecanico']) || hasPermission('corrigir_operacional');
    }

    match /vehicles/{id} {
      allow read: if activeUser() && needsVehicleRead() && (fullAccess() || unitMatchesResource());
      allow create: if fullAccess() || roleIn(['gestor','adm','mecanico']);
      allow update: if activeUser() && (fullAccess() || canRegisterDown() || canDiagnose() || canChecklist() || canOES() || canQuickMaintenance() || hasPermission('inativar_viatura')) && (fullAccess() || unitMatchesResource());
      allow delete: if fullAccess();
    }

    match /vehicle_downs/{id} {
      allow read: if activeUser() && (fullAccess() || canRegisterDown() || canDiagnose() || canChecklist() || canOES()) && (fullAccess() || unitMatchesResource());
      allow create: if activeUser() && canRegisterDown() && (fullAccess() || unitMatchesRequest());
      allow update: if activeUser() && (fullAccess() || canRegisterDown() || canDiagnose()) && (fullAccess() || unitMatchesResource());
      allow delete: if fullAccess();
    }

    match /diagnoses/{id} {
      allow read: if activeUser() && (fullAccess() || canDiagnose() || canChecklist() || canOES()) && (fullAccess() || unitMatchesResource());
      allow create: if activeUser() && canDiagnose() && (fullAccess() || unitMatchesRequest());
      allow update: if activeUser() && canDiagnose() && (fullAccess() || unitMatchesResource());
      allow delete: if fullAccess();
    }

    match /checklists/{id} {
      allow read: if activeUser() && (fullAccess() || canChecklist() || canOES() || canApproveBudget()) && (fullAccess() || unitMatchesResource());
      allow create: if activeUser() && canChecklist() && (fullAccess() || unitMatchesRequest());
      allow update: if activeUser() && canChecklist() && (fullAccess() || unitMatchesResource());
      allow delete: if fullAccess();
    }

    match /maintenance_orders/{id} {
      allow read: if activeUser() && (
        fullAccess() || canOES() || canApproveBudget() || canUGE() ||
        (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id)
      ) && (fullAccess() || profile().role != 'adm_opm' || resource.data.unit == profile().unit);
      allow create: if activeUser() && canOES() && (fullAccess() || unitMatchesRequest());
      allow update: if activeUser() && (
        fullAccess() || canOES() || canApproveBudget() || canUGE() ||
        (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id)
      ) && (fullAccess() || profile().role != 'adm_opm' || resource.data.unit == profile().unit);
      allow delete: if fullAccess();
    }

    match /budgets/{id} {
      allow read: if activeUser() && (
        fullAccess() || canOES() || canApproveBudget() || canUGE() ||
        (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id)
      );
      allow create: if activeUser() && (fullAccess() || canOES() || profile().role == 'oficina');
      allow update: if activeUser() && (fullAccess() || canApproveBudget() || profile().role == 'oficina');
      allow delete: if fullAccess();
    }

    match /workshops/{id} {
      allow read: if activeUser() && (fullAccess() || canOES() || canApproveBudget() || profile().role == 'oficina' || canManageWorkshops());
      allow create, update, delete: if activeUser() && canManageWorkshops();
    }

    match /saas2_integrations/{id} {
      allow read: if activeUser() && (canManageWorkshops() || canOES() || canApproveBudget());
      allow create, update, delete: if activeUser() && canManageWorkshops();
    }

    match /saas2_sync_events/{id} {
      allow read: if activeUser() && (canManageWorkshops() || canOES() || canApproveBudget());
      allow create, delete: if activeUser() && canManageWorkshops();
      allow update: if false;
    }

    match /saas2_chat/{id} {
      allow read, create, update: if activeUser() && (canManageWorkshops() || canOES() || canApproveBudget());
      allow delete: if activeUser() && canManageWorkshops();
    }

    match /parts/{id} {
      allow read: if activeUser() && (canStock() || canQuickMaintenance());
      allow create, update: if activeUser() && canStock();
      allow delete: if fullAccess();
    }

    match /stock_movements/{id} {
      allow read: if activeUser() && (canStock() || canQuickMaintenance());
      allow create: if activeUser() && (canStock() || canQuickMaintenance());
      allow update, delete: if fullAccess();
    }

    match /quick_maintenances/{id} {
      allow read, create, update: if activeUser() && canQuickMaintenance();
      allow delete: if fullAccess();
    }

    match /operational_logs/{id} {
      allow create: if activeUser() && canOperationalControl() || (
        request.resource.data.public_token is string &&
        exists(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)) &&
        get(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)).data.active == true &&
        request.resource.data.vehicle_id == get(/databases/$(database)/documents/public_vehicle_tokens/$(request.resource.data.public_token)).data.vehicle_id
      );
      allow read: if activeUser() && canOperationalControl() && (fullAccess() || profile().role != 'adm_opm' || resource.data.vehicle_unit == profile().unit);
      allow update: if activeUser() && canOperationalControl();
      allow delete: if fullAccess();
    }

    match /financial_flows/{id} {
      allow read: if activeUser() && (canUGE() || (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id));
      allow create: if activeUser() && (fullAccess() || canApproveBudget());
      allow update: if activeUser() && canUGE();
      allow delete: if fullAccess();
    }

    match /commitments/{id} {
      allow read, create, update: if activeUser() && canUGE();
      allow delete: if fullAccess();
    }

    match /invoices/{id} {
      allow read: if activeUser() && (canUGE() || (profile().role == 'oficina' && resource.data.workshop_id == profile().workshop_id));
      allow create: if activeUser() && (canUGE() || profile().role == 'oficina');
      allow update: if activeUser() && canUGE();
      allow delete: if fullAccess();
    }

    match /payments/{id} {
      allow read: if activeUser() && (canUGE() || hasPermission('aprovar_pagamento'));
      allow create, update: if activeUser() && (canUGE() || hasPermission('aprovar_pagamento'));
      allow delete: if fullAccess();
    }

    match /attachments/{id} {
      allow read, create: if activeUser();
      allow update, delete: if fullAccess();
    }

    match /oes_counters/{id} {
      allow read: if activeUser() && canOES();
      allow create, update: if activeUser() && canOES();
      allow delete: if fullAccess();
    }

    match /organizational_units/{id} {
      allow read: if activeUser();
      allow write: if fullAccess();
    }

    match /audit_logs/{id} {
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow read: if activeUser() && canSeeAudit();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
